<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <title>🎲 Dado de los Valores PRO</title>
  <style>
    body {
      font-family: 'Segoe UI', sans-serif;
      background: linear-gradient(#f0f8ff, #a5d6a7);
      text-align: center;
      padding: 20px;
    }
    h1 {
      margin-top: 20px;
      color: #2e7d32;
      font-size: 2.5em;
    }
    #dice {
      margin: 40px auto;
      width: 100px;
      height: 100px;
      background-color: #fff;
      border-radius: 20px;
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 3em;
      box-shadow: 2px 2px 10px rgba(0,0,0,0.3);
      cursor: pointer;
      transition: transform 0.5s ease;
    }
    #question {
      margin-top: 20px;
      font-size: 1.3em;
      color: #333;
    }
    .option {
      display: block;
      margin: 10px auto;
      padding: 12px;
      width: 60%;
      background-color: #fff;
      border-radius: 8px;
      cursor: pointer;
      transition: all 0.3s;
      box-shadow: 2px 2px 5px rgba(0,0,0,0.2);
    }
    .option:hover {
      background-color: #a5d6a7;
      transform: scale(1.05);
    }
    .selected {
      background-color: #81c784 !important;
      color: #fff;
      font-weight: bold;
    }
    #feedback {
      margin-top: 15px;
      font-weight: bold;
      font-size: 1.2em;
    }
    #score, #counter {
      margin-top: 20px;
      font-size: 1.2em;
      color: #2e7d32;
    }
    #restart {
      margin-top: 20px;
      padding: 10px 20px;
      font-size: 1em;
      border-radius: 10px;
      border: none;
      background-color: #4caf50;
      color: white;
      cursor: pointer;
      display: none;
    }
    #restart:hover {
      background-color: #388e3c;
    }
  </style>
</head>
<body>

  <h1>🎲 Dado de los Valores 🎲</h1>
  <div id="dice" onclick="rollDice()">🎲</div>

  <div id="question"></div>
  <div id="options"></div>
  <div id="feedback"></div>
  <div id="score">Puntos: 0</div>
  <div id="counter">Preguntas respondidas: 0/6</div>
  <button id="restart" onclick="restartGame()">🔄 Reiniciar Juego</button>

  <audio id="rollSound" src="https://cdn.pixabay.com/download/audio/2022/03/15/audio_dfa17f88d2.mp3?filename=spin-1-46135.mp3"></audio>
  <audio id="correctSound" src="https://cdn.pixabay.com/download/audio/2022/03/15/audio_ee4f4f1de8.mp3?filename=correct-2-46134.mp3"></audio>
  <audio id="wrongSound" src="https://cdn.pixabay.com/download/audio/2022/03/15/audio_b3e53e926e.mp3?filename=wrong-2-46133.mp3"></audio>

  <script>
    const questions = [
      {
        question: "¿Qué valor practicas cuando compartes tus cosas?",
        options: ["Solidaridad", "Obediencia", "Orgullo"],
        answer: "Solidaridad"
      },
      {
        question: "Escuchar con atención a los demás es un acto de...",
        options: ["Respeto", "Diversión", "Puntualidad"],
        answer: "Respeto"
      },
      {
        question: "Cuando ayudas a alguien sin que te lo pidan, demuestras...",
        options: ["Empatía", "Mentira", "Irresponsabilidad"],
        answer: "Empatía"
      },
      {
        question: "Ser honesto y decir la verdad es practicar...",
        options: ["Sinceridad", "Alegría", "Egoísmo"],
        answer: "Sinceridad"
      },
      {
        question: "Si cumples con tus tareas a tiempo, demuestras...",
        options: ["Solidaridad", "Responsabilidad", "Respeto"],
        answer: "Responsabilidad"
      },
      {
        question: "Cuando respetas las reglas de un juego practicas...",
        options: ["Respeto", "Mentira", "Desobediencia"],
        answer: "Respeto"
      }
    ];

    let score = 0;
    let waitingForAnswer = false;
    let answered = 0;

    function rollDice() {
      if (waitingForAnswer || answered >= questions.length) return;
      const dice = document.getElementById('dice');
      const roll = Math.floor(Math.random() * 6) + 1;
      document.getElementById('rollSound').play();
      dice.style.transform = 'rotate(360deg)';
      setTimeout(() => {
        dice.textContent = roll;
        showQuestion(roll - 1);
        dice.style.transform = 'rotate(0deg)';
      }, 500);
    }

    function showQuestion(index) {
      const q = questions[index];
      document.getElementById('question').textContent = q.question;
      const optionsDiv = document.getElementById('options');
      optionsDiv.innerHTML = "";
      q.options.forEach(opt => {
        const btn = document.createElement('div');
        btn.textContent = opt;
        btn.className = "option";
        btn.onclick = () => checkAnswer(opt, q.answer, btn);
        optionsDiv.appendChild(btn);
      });
      document.getElementById('feedback').textContent = "";
      waitingForAnswer = true;
    }

    function checkAnswer(selected, correct, button) {
      const feedback = document.getElementById('feedback');
      const options = document.querySelectorAll('.option');
      options.forEach(opt => opt.onclick = null);

      if (selected === correct) {
        feedback.textContent = "✅ ¡Correcto! +10 puntos";
        feedback.style.color = "green";
        score += 10;
        document.getElementById('correctSound').play();
      } else {
        feedback.textContent = "❌ Incorrecto";
        feedback.style.color = "red";
        document.getElementById('wrongSound').play();
      }

      button.classList.add('selected');

      answered++;
      document.getElementById('score').textContent = "Puntos: " + score;
      document.getElementById('counter').textContent = `Preguntas respondidas: ${answered}/6`;
      waitingForAnswer = false;
      document.getElementById('dice').textContent = "🎲";

      if (answered >= questions.length) {
        document.getElementById('feedback').textContent += " \u2728 Juego terminado! Puntaje final: " + score;
        document.getElementById('restart').style.display = 'inline-block';
      }
    }

    function restartGame() {
      score = 0;
      answered = 0;
      document.getElementById('score').textContent = "Puntos: 0";
      document.getElementById('counter').textContent = "Preguntas respondidas: 0/6";
      document.getElementById('question').textContent = "";
      document.getElementById('options').innerHTML = "";
      document.getElementById('feedback').textContent = "";
      document.getElementById('restart').style.display = 'none';
      document.getElementById('dice').textContent = "🎲";
    }
  </script>

</body>
</html>
